LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional for compatible models. GitHub's Qwen evaluation uses medium and streaming.
LLM_REASONING_EFFORT=
LLM_STREAM=false
LLM_TIMEOUT_SECONDS=90
# Optional provider output-token cap; empty preserves provider defaults.
LLM_MAX_OUTPUT_TOKENS=
REPOPILOT_DOCKER_IMAGE=repopilot-sandbox:dev
REPOPILOT_MAX_STEPS=15
REPOPILOT_MAX_CONTEXT_CHARS=30000
REPOPILOT_REFLECTION=0
REPOPILOT_RETRIEVAL=legacy
REPOPILOT_MEMORY=0
# Empty: per-repository SQLite. API may set PostgreSQL through Compose.
REPOPILOT_DATABASE_URL=
# Empty: bounded asyncio queue. Compose enables Redis + PostgreSQL.
REPOPILOT_REDIS_URL=
POSTGRES_PASSWORD=repopilot-local
# Set a real embedding model to activate FAISS semantic recall; otherwise BM25+AST.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Optional tracing. No SDK imports or export unless explicitly enabled.
REPOPILOT_OTEL_ENABLED=0
REPOPILOT_OTEL_EXPORTER=console
# OTLP exporter needs a complete traces URL, e.g. http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
REPOPILOT_REPOS_DIR=./workspaces
REPOPILOT_HOST_UID=10001
REPOPILOT_HOST_GID=10001
